{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Petrik Navigator",
  "version": "1.0.3",
  "identifier": "hu.petrik.navigator",
  "build": {
    "beforeDevCommand": "bun dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Petrik Navigator",
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxNDFCMkVFMTEyRjREQkQKUldTOVRTOFI3ckpCMFRCQ0Z6QWJwZ0hjZWF4eVcwQ3VlS1hlc2hObkx3aFZqYXJxRm1mVWtzeFMK",
      "endpoints": [
        "https://github.com/filcdev/Navigator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
